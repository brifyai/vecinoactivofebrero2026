# JWT Secret (de Supabase self-hosted)
# ⚠️ REEMPLAZAR_CON_UN_SECRET_SEGURO_DE_128_CARACTERES_HEX
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# El comando genera 128 caracteres hexadecimales (64 bytes)
JWT_SECRET=REPLACE_WITH_A_SECURE_128_HEX_CHAR_SECRET

# Server Configuration
PORT=3008

# CORS Configuration - Lista de orígenes permitidos (separados por coma)
# ⚠️ IMPORTANTE: No usar '*' en producción. Especificar dominios explícitos.
# Ejemplo: https://vecinoactivo.cl,https://app.vecinoactivo.cl
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:4001,https://vecinoactivo.cl,https://www.vecinoactivo.cl

# Notas:
# 1. El backend escucha en el puerto 3008
# 2. Nginx proxy pasa las peticiones /api/ al puerto 3008
# 3. Las claves JWT deben coincidir con las de Supabase self-hosted
# 4. CORS_ORIGIN debe contener solo dominios explícitos, nunca '*'
