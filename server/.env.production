# ============================================
# Configuración de Producción - Vecino Activo
# ============================================

# Supabase Configuration
SUPABASE_URL=https://supabase.vecinoactivo.cl
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# JWT Secret (generar con: openssl rand -base64 32)
JWT_SECRET=YOUR_JWT_SECRET_HERE_MIN_32_CHARS

# Server Configuration
PORT=3002
CORS_ORIGIN=https://vecinoactivo.cl,https://www.vecinoactivo.cl

# Notas:
# 1. Reemplazar YOUR_SERVICE_ROLE_KEY_HERE con la clave de servicio de Supabase
# 2. Reemplazar YOUR_JWT_SECRET_HERE_MIN_32_CHARS con un secreto seguro de al menos 32 caracteres
# 3. El backend escucha en el puerto 3002
# 4. Nginx proxy pasa las peticiones /api/ al puerto 3002
