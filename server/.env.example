# Supabase Configuration
SUPABASE_URL=https://supabase.vecinoactivo.cl
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret
# ⚠️ REEMPLAZAR_CON_UN_SECRET_SEGURO_DE_128_CARACTERES_HEX
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# El comando genera 128 caracteres hexadecimales (64 bytes)
JWT_SECRET=REPLACE_WITH_A_SECURE_128_HEX_CHAR_SECRET

# Server Configuration
PORT=3001

# CORS Configuration - Lista de orígenes permitidos (separados por coma)
# ⚠️ IMPORTANTE: No usar '*' en producción. Especificar dominios explícitos.
# En desarrollo: http://localhost:5173
# En producción: https://tudominio.cl,https://app.tudominio.cl
CORS_ORIGIN=http://localhost:5173
